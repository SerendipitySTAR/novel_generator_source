# 应用配置
APP_NAME=自动小说生成器
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8002

# 数据库配置
# 开发环境使用SQLite
DATABASE_URL=sqlite:///./novel_generator.db
# 生产环境使用PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/novel_generator

# LLM配置
OPENAI_API_KEY=sk-dummy-key
OPENAI_API_BASE=http://localhost:8321/v1
DEFAULT_LLM_MODEL=gpt-4o-2024-08-06

# 向量数据库配置
VECTOR_DB_PATH=./vector_db

# 知识图谱配置（可选）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/novel_generator.log
ENABLE_JSON_LOGS=false

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_AUTHENTICATION=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# 文件存储配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# 监控配置（可选）
SENTRY_DSN=your-sentry-dsn
ENABLE_METRICS=false
METRICS_PORT=9090
